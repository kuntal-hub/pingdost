# /srv/pingdost/.env on the VPS (chmod 600, owner deploy). Never commit the real file.
# Make each secret with: openssl rand -base64 32   (use -hex 24 where noted: URL-safe)

# --- Compose ---------------------------------------------------------------------------
GHCR_OWNER=your-github-username          # lowercase; images are ghcr.io/<owner>/pingdost-server
SERVER_TAG=staging                       # the deploy workflow sets the release tag
API_DOMAIN=api.pingdost.com
ACME_EMAIL=you@example.com               # Let's Encrypt expiry notices
VALKEY_PASSWORD=                          # openssl rand -hex 24 (also inside REDIS_URL below)

# --- Server (packages/config; production has no defaults for these) ---------------------
PUBLIC_API_URL=https://api.pingdost.com
PUBLIC_WS_URL=wss://api.pingdost.com/v1/ws
WEB_ORIGIN=https://app.pingdost.com      # the Cloudflare Pages origin (CORS)
MONGODB_URI=                              # Atlas: mongodb+srv://pingdost-api:<password>@<cluster>/pingdost?retryWrites=true&w=majority
REDIS_URL=redis://:<VALKEY_PASSWORD>@valkey:6379
ACCESS_TOKEN_SIGNING_KEY=                 # openssl rand -base64 32
SERVER_HMAC_PEPPER=                       # openssl rand -base64 32 (changing it voids OTPs and refresh tokens)
METRICS_TOKEN=                            # openssl rand -hex 24
HEARTBEAT_URL=                            # healthchecks.io ping URL of the "pingdost jobs" check
LOG_LEVEL=info

# --- Email (pick one) -------------------------------------------------------------------
EMAIL_FROM=PingDost <no-reply@pingdost.com>
# ZeptoMail (HTTP API):
EMAIL_PROVIDER=zeptomail
EMAIL_API_KEY=                            # "Send Mail" token from the mail agent
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email   # the host your mail agent shows (regional)
# Or Brevo SMTP (300 emails a day):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Optional features (set a whole group or leave it out) ------------------------------
# GOOGLE_CLIENT_IDS=                      # Google sign-in audiences (web + Android client IDs)
# FCM_PROJECT_ID=                         # push wakes (Phase 12)
# FCM_SERVICE_ACCOUNT_JSON_BASE64=
# WEB_PUSH_VAPID_PUBLIC_KEY=              # pnpm --filter @pingdost/server vapid-keys
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:you@example.com
# APNS_KEY_ID=                            # iPhone pushes (Phase 29, ADR 0032; Apple account)
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY_BASE64=                # base64 of the .p8 file
# APNS_BUNDLE_ID=com.pingdost.app
# CLOUDINARY_CLOUD_NAME=                  # profile pictures
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Calls (Phase 25, ADR 0028; coturn in compose.staging.yml) ---------------------------
# The server hands out short-lived TURN credentials; coturn checks them with the same secret.
STUN_URLS=stun:turn.pingdost.com:3478
TURN_URLS=turn:turn.pingdost.com:3478?transport=udp,turn:turn.pingdost.com:3478?transport=tcp
TURN_SHARED_SECRET=                       # openssl rand -hex 32 (coturn reads it too)
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_REALM=turn.pingdost.com              # coturn only
TURN_EXTERNAL_IP=                         # coturn only: the VPS's public IPv4

# --- Monitoring (deploy/scripts/monitor.sh) ---------------------------------------------
MONITOR_PING_URL=                         # healthchecks.io ping URL of the "pingdost thresholds" check
