# PingDost server configuration (REQ §17 + ARCHITECTURE A11).
# Copy to .env for local development. Never commit real secrets.
# Blank values count as unset. Outside production, unset values fall back to the
# dev defaults in packages/config/src/server.ts (they match docker-compose.yml).
# In production (NODE_ENV=production) nothing is defaulted and missing secrets fail startup.
#
# Generate key material with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

# --- Core ---
NODE_ENV=development                        # development | test | production
PORT=3000
PUBLIC_API_URL=http://localhost:3000        # use your PC's LAN IP when testing on a phone
PUBLIC_WS_URL=ws://localhost:3000/ws
WEB_ORIGIN=http://localhost:5173            # allowed CORS / WS origin of the web app

# --- Datastores (docker-compose) ---
MONGODB_URI=mongodb://localhost:27017/pingdost?replicaSet=rs0
REDIS_URL=redis://localhost:6379            # Upstash or Valkey; replaces UPSTASH_REDIS_URL/TOKEN
RUN_WORKER_IN_PROCESS=true                  # run background jobs inside the API process

# --- Delivery mailbox (REQ §9) ---
MESSAGE_REDIS_STAGE_SECONDS=50400           # 14 h hot stage in Redis; must be < MAX_RETENTION
MESSAGE_MAX_RETENTION_SECONDS=1209600       # 14 days, then undelivered envelopes are deleted
MESSAGE_MIGRATION_GRACE_SECONDS=900         # Redis -> Mongo migration grace window
MESSAGE_MIGRATION_POLL_SECONDS=300          # must be <= MESSAGE_MIGRATION_GRACE_SECONDS / 3
MESSAGE_REAPER_INTERVAL_SECONDS=60          # expired-envelope sweep interval
MESSAGE_ONLINE_ACK_TIMEOUT_MS=5000          # wait for a device ack before mailboxing
ENVELOPE_MAX_BYTES=65536                    # max encrypted envelope size

# --- Attachments (REQ §10) ---
ATTACHMENT_MAX_BYTES=104857600              # 100 MB (binary MB, ARCHITECTURE A8)
ATTACHMENT_MAX_RETENTION_SECONDS=1209600    # must be <= MESSAGE_MAX_RETENTION_SECONDS
ATTACHMENT_PRESIGNED_URL_TTL_SECONDS=300
ATTACHMENT_STORE=fs                         # fs (local disk) | s3 (R2 / MinIO)
ATTACHMENT_FS_ROOT=./.data/attachments
ATTACHMENT_USER_QUOTA_BYTES=1073741824      # 1 GB of staged ciphertext per user
ATTACHMENT_ORPHAN_SECONDS=21600             # delete never-referenced uploads after 6 h
# Object store group: required when ATTACHMENT_STORE=s3 (set all or none).
ATTACHMENT_OBJECT_STORE_ENDPOINT=
ATTACHMENT_OBJECT_STORE_BUCKET=
ATTACHMENT_OBJECT_STORE_ACCESS_KEY=
ATTACHMENT_OBJECT_STORE_SECRET_KEY=

# --- Email and OTP ---
EMAIL_PROVIDER=smtp                         # smtp (Mailpit in dev) | zeptomail | console
EMAIL_FROM=PingDost <no-reply@pingdost.localhost>
EMAIL_API_KEY=                              # ZeptoMail only
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=30        # must be < EMAIL_OTP_TTL_SECONDS
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_CONSOLE_SHOW_CONTENT=false            # console provider only; never true in production
# SMTP group (host + port together; user + pass together). Dev: Mailpit, UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Tokens and password hashing ---
ACCESS_TOKEN_SIGNING_KEY=                   # >= 32 random bytes, base64; dev uses a built-in dev-only key
SERVER_HMAC_PEPPER=                         # >= 32 random bytes, base64 (OTP / refresh-token hashing)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ARGON2_MEMORY_KIB=19456                     # OWASP minimum is 19456 with 2 iterations
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# --- Social login ---
GOOGLE_CLIENT_IDS=                          # comma-separated public client IDs (web + Android); no secret needed
FACEBOOK_APP_ID=                            # deferred and unused (docs/CHANGES.md)
FACEBOOK_APP_SECRET=

# --- Avatars (Cloudinary group: all or none) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Push (each group: all or none) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_BASE64=            # service-account JSON, base64-encoded
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=                           # mailto:you@example.com or https://...

# --- Web pairing, history sync, groups ---
WEB_PAIRING_TTL_SECONDS=120
SYNC_RECENT_DAYS=30
GROUP_MAX_MEMBERS=64

# --- Mesh (REQ §11.4) ---
MESH_PACKET_MAX_HOPS=8                      # 1..32
MESH_PACKET_TTL_SECONDS=1209600
MESH_RELAY_STORAGE_LIMIT_BYTES=262144000    # 250 MB relay budget per device

# --- Calls (REQ §12) ---
STUN_URLS=                                  # comma-separated stun: URLs
TURN_URLS=                                  # comma-separated turn:/turns: URLs (TURN group with the secret)
TURN_SHARED_SECRET=                         # coturn static-auth-secret, >= 32 chars
TURN_CREDENTIAL_TTL_SECONDS=3600

# --- Operations ---
SECURITY_EVENT_RETENTION_SECONDS=7776000    # 90 days
METRICS_TOKEN=                              # >= 32 chars; unset disables the metrics endpoint

# --- Clients (set these in the app's own .env, not here) ---
# apps/mobile/.env:  EXPO_PUBLIC_API_URL=http://192.168.x.x:3000   EXPO_PUBLIC_WS_URL=ws://192.168.x.x:3000/ws
# apps/web/.env:     VITE_API_URL=http://localhost:3000             VITE_WS_URL=ws://localhost:3000/ws
