# The web app's public config (ADR 0002): copy to apps/web/.env. Only VITE_* values reach the
# bundle; never put a secret here.
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/v1/ws
# Optional: the server's VAPID public key for notifications (pnpm --filter @pingdost/server vapid-keys).
VITE_WEB_PUSH_PUBLIC_KEY=
# Optional: the attachment store's URL when signed URLs are not on the API (S3, ADR 0017/0021).
VITE_STORAGE_URL=
