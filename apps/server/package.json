{
  "name": "@pingdost/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/websocket": "11.3.4",
    "@node-rs/argon2": "2.2.2",
    "@pingdost/config": "workspace:*",
    "@pingdost/protocol": "workspace:*",
    "@pingdost/shared-types": "workspace:*",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "mongodb": "7.7.0",
    "nodemailer": "10.1.7",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pingdost/api-client": "workspace:*",
    "@pingdost/crypto": "workspace:*",
    "@pingdost/sim-client": "workspace:*",
    "@pingdost/transport": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.2",
    "@types/ws": "8.18.2",
    "pino-pretty": "13.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
