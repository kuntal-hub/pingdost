# Copy to apps/mobile/.env.production (git-ignored) for release builds that talk to staging
# (Phase 20, docs/ops/mobile-release.md). Expo reads `.env.production` when it bundles a release
# build; `.env` (the PC's LAN address) stays for dev builds. Public values only (ADR 0002).
EXPO_PUBLIC_API_URL=https://api.pingdost.com
EXPO_PUBLIC_WS_URL=wss://api.pingdost.com/v1/ws
# Google sign-in (optional): the web client ID from Google Cloud.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
