{
  "expo": {
    "name": "PingDost",
    "slug": "pingdost",
    "version": "0.1.0",
    "scheme": "pingdost",
    "platforms": ["android", "ios"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pingdost.app"
    },
    "android": {
      "package": "com.pingdost.app",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.DETECT_SCREEN_CAPTURE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B7A64",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "x86_64"],
            "extraProguardRules": "-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PingDost opens your photos only when you pick one to send or as your profile picture.",
          "cameraPermission": "PingDost uses the camera during video calls, when you take a photo or video to send, and to scan QR codes.",
          "microphonePermission": "PingDost uses the microphone during calls, and while you record a video or a voice note."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PingDost uses the camera during video calls, when you take a photo or video to send, and to scan QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "PingDost uses the microphone during calls, and while you record a video or a voice note.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0B7A64",
          "defaultChannel": "messages"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "PingDost uses the camera during video calls, when you take a photo or video to send, and to scan QR codes.",
          "microphonePermission": "PingDost uses the microphone during calls, and while you record a video or a voice note."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
